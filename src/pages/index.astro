---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LatestBlog from '../components/LatestBlog.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>Welcome to a personal website of</h1>
				<h2>Panu Tangchalermkul</h2>
				<p>I am a software engineer from Thailand, living in London with my wife and daughter.</p>
				<p>I love drinking coffee, reading fiction and manga, playing video games, following the latest tech news, listening to old music, watching movies, cartoons, series, and anime.</p>
				<p>I also like hiking and having ideas about projects I want to build, but never got time to actually do it.</p>
				<p>This website is where I write <a href="/blogs">blogs</a>, share <a href="/favourites">favourites</a>, keep track of <a href="/ideas">ideas</a>, and everything else <a href="/aboutme">about me</a>.</p>
			</section>
			<section>
				<p>My latest blog post is</p>
				<LatestBlog />
			</section>
		</main>
		<Footer />
	</body>
</html>
